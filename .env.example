# ---------- Provedor de dados ----------
# mock | the_odds_api | generic_json
BETAI_PROVIDER=mock

# the_odds_api (https://the-odds-api.com — tem plano gratuito)
THE_ODDS_API_KEY=
BETAI_SPORT=soccer_brazil_campeonato
BETAI_REGIONS=eu
# Casa específica; em branco usa a primeira retornada
BETAI_BOOKMAKER=

# generic_json: caminho do arquivo de mapeamento de campos
BETAI_FIELD_MAP=examples/field_map.json

# ---------- Motor quantitativo ----------
# multiplicative | additive | power | shin
BETAI_DEVIG=power
# Gols esperados quando não há mercado de over/under para calibrar
BETAI_PRIOR_TOTAL=2.7
# Edge mínimo para reportar (0.03 = 3%)
BETAI_MIN_EDGE=0.03
# Fração de Kelly. 0.25 = um quarto de Kelly
BETAI_KELLY_FRACTION=0.25

# ---------- Camada de IA ----------
ANTHROPIC_API_KEY=
BETAI_MODEL=claude-opus-5
# low | medium | high | xhigh | max
BETAI_EFFORT=medium
# Teto do ajuste da IA, em pontos de probabilidade
BETAI_MAX_AI_SHIFT=0.05

# ---------- Persistência ----------
BETAI_DB=./bet-ai.db
